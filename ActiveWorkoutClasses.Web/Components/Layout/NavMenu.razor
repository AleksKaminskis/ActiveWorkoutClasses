@inject NavigationManager Nav

<MudNavMenu>

    <MudText Typo="Typo.overline" Class="px-4 pt-3 pb-1" Style="color:#90A4AE;font-size:0.65rem;letter-spacing:1.5px;">
        GENERAL
    </MudText>

    <MudNavLink Href="/classes" Icon="@Icons.Material.Filled.FitnessCenter">
        Classes
    </MudNavLink>

    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Student">
        <Authorized>
            <MudText Typo="Typo.overline" Class="px-4 pt-3 pb-1" Style="color:#90A4AE;font-size:0.65rem;letter-spacing:1.5px;">
                MY TRAINING
            </MudText>
            <MudNavLink Href="/my-classes" Icon="@Icons.Material.Filled.Event">
                My Classes
            </MudNavLink>
            <MudNavLink Href="/check-in" Icon="@Icons.Material.Filled.QrCodeScanner">
                Check In
            </MudNavLink>
            <MudNavLink Href="/my-progress" Icon="@Icons.Material.Filled.TrendingUp">
                My Progress
            </MudNavLink>
            <MudNavLink Href="/my-gradings" Icon="@Icons.Material.Filled.EmojiEvents">
                Gradings
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Admin,Instructor">
        <Authorized>
            <MudText Typo="Typo.overline" Class="px-4 pt-3 pb-1" Style="color:#90A4AE;font-size:0.65rem;letter-spacing:1.5px;">
                MANAGEMENT
            </MudText>
            <MudNavLink Href="/grading-events" Icon="@Icons.Material.Filled.Grade">
                Grading Events
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudText Typo="Typo.overline" Class="px-4 pt-3 pb-1" Style="color:#90A4AE;font-size:0.65rem;letter-spacing:1.5px;">
                ADMIN
            </MudText>
            <MudNavLink Href="/admin/dashboard" Icon="@Icons.Material.Filled.Analytics">
                Analytics
            </MudNavLink>
            <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.People">
                Users
            </MudNavLink>
            <MudNavLink Href="/admin/locations" Icon="@Icons.Material.Filled.LocationOn">
                Locations
            </MudNavLink>
            <MudNavLink Href="/admin/schedules" Icon="@Icons.Material.Filled.Schedule">
                Schedules
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

</MudNavMenu>
