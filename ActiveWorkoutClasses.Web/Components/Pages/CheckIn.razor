@page "/check-in"
@attribute [Authorize(Roles = "Student")]

@using ActiveWorkoutClasses.Application.DTOs.Attendance
@using ActiveWorkoutClasses.Application.DTOs.Registrations

@inject IApiClient Api
@inject IAuthStateService AuthState
@inject ISnackbar Snackbar

<PageTitle>Check In</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
    <div>
        <MudText Typo="Typo.h4" Style="font-family:'Barlow Condensed',sans-serif;font-weight:700;">
            Check In to Class
        </MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            Student number:
            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="ml-1">
                @(AuthState.StudentNumber ?? "—")
            </MudChip>
        </MudText>
    </div>
    <MudText Typo="Typo.body2" Color="Color.Secondary">
        @DateTime.Now.ToString("dddd, dd MMMM yyyy")
    </MudText>
</MudStack>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
    <MudGrid>
        @for (int i = 0; i < 3; i++)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="180px" />
            </MudItem>
        }
    </MudGrid>
}
else if (!_todaysRegistrations.Any())
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
        You have no classes registered for today.
    </MudAlert>
}
else
{
    <MudGrid>
        @foreach (var reg in _todaysRegistrations)
        {
            var isChecking = _checkingIds.Contains(reg.Id);
            var isCheckedIn = reg.HasAttendance && reg.Attendance?.IsPresent == true;

            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="3" Style="height:100%;display:flex;flex-direction:column;">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Style="font-family:'Barlow Condensed',sans-serif;font-weight:700;line-height:1.2;">
                                @reg.ClassName
                            </MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (isCheckedIn)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                            }
                        </CardHeaderActions>
                    </MudCardHeader>

                    <MudCardContent Style="flex:1">
                        <MudStack Spacing="2">
                            @if (!string.IsNullOrWhiteSpace(reg.ClassLocation))
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.body2">@reg.ClassLocation</MudText>
                                </MudStack>
                            }
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">
                                    @reg.ClassStartTime.ToString("HH:mm") – @reg.ClassEndTime.ToString("HH:mm")
                                </MudText>
                            </MudStack>
                            @if (isCheckedIn && reg.Attendance?.CheckInTime is not null)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                                    <MudText Typo="Typo.body2" Color="Color.Success">
                                        Checked in at @reg.Attendance.CheckInTime.Value.ToString("HH:mm")
                                    </MudText>
                                </MudStack>
                            }
                        </MudStack>
                    </MudCardContent>

                    <MudCardActions>
                        <MudButton Variant="Variant.Filled"
                                   Color="@(isCheckedIn ? Color.Success : Color.Primary)"
                                   FullWidth="true"
                                   Disabled="@(isCheckedIn || isChecking)"
                                   OnClick="@(() => HandleCheckIn(reg))">
                            @if (isChecking)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            @(isCheckedIn ? "Checked In" : "Check In")
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {

    private bool _isLoading = true;
    private List<ClassRegistrationDto> _todaysRegistrations = new();
    private HashSet<Guid> _checkingIds = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await Api.GetAsync<List<ClassRegistrationDto>>("api/registrations/my");
            if (all is not null)
            {
                var today = DateTime.UtcNow.Date;
                _todaysRegistrations = all
                    .Where(r => r.ClassStartTime.Date == today && r.Status == RegistrationStatus.Registered)
                    .OrderBy(r => r.ClassStartTime)
                    .ToList();
            }
        }
        catch { Snackbar.Add("Failed to load today's classes", Severity.Error); }
        finally { _isLoading = false; }
    }

    private async Task HandleCheckIn(ClassRegistrationDto reg)
    {
        _checkingIds.Add(reg.Id);
        try
        {
            var result = await Api.PostAsync<CheckInResultDto>(
                $"api/attendance/checkin?registrationId={reg.Id}&studentId={reg.StudentId}", new { });

            if (result?.Success == true)
            {
                reg.HasAttendance = true;
                reg.Attendance = result.Attendance;
                Snackbar.Add("Checked in successfully!", Severity.Success);
            }
            else
            {
                Snackbar.Add(result?.Message ?? "Check-in failed", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _checkingIds.Remove(reg.Id);
        }
    }

}
