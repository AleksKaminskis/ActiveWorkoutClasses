@page "/classes"

@inject IApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IAuthStateService AuthState

<PageTitle>Classes — Active Workout</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
    <MudText Typo="Typo.h4" Style="font-family:'Barlow Condensed',sans-serif;font-weight:700;">
        Workout Classes
    </MudText>
    <AuthorizeView Roles="Admin,Instructor">
        <Authorized>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/classes/create">
                New Class
            </MudButton>
        </Authorized>
    </AuthorizeView>
</MudStack>

<MudPaper Class="pa-4 mb-6" Elevation="2">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudTextField T="string"
                          @bind-Value="_search"
                          Placeholder="Search by title or description…"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Clearable="true" />
        </MudItem>
        <MudItem xs="6" md="3">
            <MudSelect T="ClassType?" @bind-Value="_typeFilter" Label="Discipline" Variant="Variant.Outlined" Clearable="true">
                <MudSelectItem Value="@((ClassType?)null)">All disciplines</MudSelectItem>
                @foreach (var t in Enum.GetValues<ClassType>())
                {
                    <MudSelectItem Value="@((ClassType?)t)">@t</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudSelect T="string" @bind-Value="_availFilter" Label="Availability" Variant="Variant.Outlined">
                <MudSelectItem Value="@("All")">All</MudSelectItem>
                <MudSelectItem Value="@("Available")">Spaces available</MudSelectItem>
                <MudSelectItem Value="@("Full")">Full</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ClearFilters" FullWidth="true">
                Clear
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
    <MudGrid>
        @for (int i = 0; i < 6; i++)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="240px" />
            </MudItem>
        }
    </MudGrid>
}
else if (!Filtered.Any())
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        No classes match your filters.
    </MudAlert>
}
else
{
    <MudGrid>
        @foreach (var cls in Filtered)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="3" Style="@($"height:100%;display:flex;flex-direction:column;{(!cls.IsActive ? "opacity:0.6;border:1px solid var(--mud-palette-error);" : "")}")">
                    @if (!cls.IsActive)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="ma-0" Icon="@Icons.Material.Filled.VisibilityOff">
                            Inactive — not visible to members
                        </MudAlert>
                    }

                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <MudAvatar Color="@ClassColor(cls.ClassType)" Variant="Variant.Filled">
                                <MudIcon Icon="@ClassIcon(cls.ClassType)" />
                            </MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Style="line-height:1.2">@cls.Title</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@ClassColor(cls.ClassType)" Variant="Variant.Filled">
                                @cls.ClassTypeName
                            </MudChip>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(cls.IsFull ? Color.Error : Color.Success)"
                                     Variant="Variant.Outlined">
                                @(cls.IsFull ? "Full" : $"{cls.AvailableSpots} spots")
                            </MudChip>
                        </CardHeaderActions>
                    </MudCardHeader>

                    <MudCardContent Style="flex:1">
                        @if (!string.IsNullOrWhiteSpace(cls.Description))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                @(cls.Description.Length > 100 ? cls.Description[..100] + "…" : cls.Description)
                            </MudText>
                        }
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">@cls.StartDateTime.ToString("ddd dd MMM, HH:mm")</MudText>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">@cls.DurationMinutes min</MudText>
                            </MudStack>
                            @if (!string.IsNullOrWhiteSpace(cls.Location))
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.body2">@cls.Location</MudText>
                                </MudStack>
                            }
                            @if (cls.Instructors?.Any() == true)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.body2">@string.Join(", ", cls.Instructors.Select(i => i.FullName))</MudText>
                                </MudStack>
                            }
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">@cls.CurrentEnrollment / @cls.MaxCapacity enrolled</MudText>
                            </MudStack>
                        </MudStack>
                    </MudCardContent>

                    <MudCardActions>
                        <AuthorizeView Roles="Student">
                            <Authorized>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           Disabled="@cls.IsFull"
                                           Href="/my-classes">
                                    @(cls.IsFull ? "Full" : "Register")
                                </MudButton>
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView Roles="Admin,Instructor">
                            <Authorized>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Warning" Size="Size.Small"
                                               OnClick="@(() => Nav.NavigateTo($"/classes/edit/{cls.Id}"))"
                                               Title="Edit" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => ConfirmDelete(cls))"
                                               Title="Delete" />
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView>
                            <NotAuthorized>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           Href="/login">
                                    Sign in to register
                                </MudButton>
                            </NotAuthorized>
                        </AuthorizeView>
                    </MudCardActions>

                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

<MudMessageBox @ref="_msgBox" Title="Delete class?" CancelText="Cancel">
    <MessageContent>
        Are you sure you want to delete <strong>@_deleteTarget?.Title</strong>? This cannot be undone.
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error">Delete</MudButton>
    </YesButton>
</MudMessageBox>

@code {

    private List<WorkoutClassDto> _classes = new();
    private bool _isLoading = true;

    private string _search = string.Empty;
    private ClassType? _typeFilter;
    private string _availFilter = "All";

    private MudMessageBox? _msgBox;
    private WorkoutClassDto? _deleteTarget;

    private IEnumerable<WorkoutClassDto> Filtered => _classes
        .Where(c => string.IsNullOrWhiteSpace(_search) ||
                    c.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    c.Description.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(c => _typeFilter is null || c.ClassType == _typeFilter)
        .Where(c => _availFilter switch
        {
            "Available" => !c.IsFull,
            "Full" => c.IsFull,
            _ => true
        });

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var isStaff = AuthState.UserRole is "Admin" or "Instructor";
            var url = isStaff ? "api/classes?includeInactive=true" : "api/classes";
            _classes = await Api.GetAsync<List<WorkoutClassDto>>(url) ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load classes: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ClearFilters()
    {
        _search = string.Empty;
        _typeFilter = null;
        _availFilter = "All";
    }

    private async Task ConfirmDelete(WorkoutClassDto cls)
    {
        _deleteTarget = cls;
        var confirmed = await _msgBox!.ShowAsync();
        if (confirmed != true) return;

        var ok = await Api.DeleteAsync($"api/classes/{cls.Id}");
        if (ok)
        {
            _classes.RemoveAll(c => c.Id == cls.Id);
            Snackbar.Add("Class deleted.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to delete class.", Severity.Error);
        }
        _deleteTarget = null;
    }

    private static Color ClassColor(ClassType t) => t switch
    {
        ClassType.KravMaga => Color.Error,
        ClassType.Boxing   => Color.Warning,
        ClassType.Yoga     => Color.Success,
        ClassType.Pilates  => Color.Tertiary,
        ClassType.HIIT     => Color.Secondary,
        _                  => Color.Primary
    };

    private static string ClassIcon(ClassType t) => t switch
    {
        ClassType.KravMaga => Icons.Material.Filled.Shield,
        ClassType.Boxing   => Icons.Material.Filled.SportsKabaddi,
        ClassType.Yoga     => Icons.Material.Filled.SelfImprovement,
        ClassType.Pilates  => Icons.Material.Filled.FitnessCenter,
        ClassType.HIIT     => Icons.Material.Filled.DirectionsRun,
        _                  => Icons.Material.Filled.FitnessCenter
    };
}
