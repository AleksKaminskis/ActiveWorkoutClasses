@page "/classes/edit/{Id:guid}"

@using ActiveWorkoutClasses.Application.DTOs.Classes
@using ActiveWorkoutClasses.Domain.Enums
@using MudBlazor

@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Edit Class</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Edit Class</MudText>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-6">

        <MudForm @ref="form">

            <MudGrid>

                <MudItem xs="12" md="4">
                    <MudTextField Label="Title"
                                  @bind-Value="model.Title"
                                  Required="true"
                                  RequiredError="Title is required" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect T="ClassType"
                               Label="Class Type"
                               @bind-Value="model.ClassType"
                               Required="true">

                        @foreach (var type in Enum.GetValues<ClassType>())
                        {
                            <MudSelectItem Value="@type">@type</MudSelectItem>
                        }

                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSwitch T="bool"
                               Label="Active"
                               Color="Color.Success"
                               @bind-Checked="model.IsActive" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField Label="Description"
                                  Lines="3"
                                  @bind-Value="model.Description" />
                </MudItem>

                <MudItem xs="12">

                    <MudAutocomplete T="InstructorSummaryDto"
                                     @ref="instructorAuto"
                                     Label="Add Instructor"
                                     Dense="true"
                                     Clearable="true"
                                     ToStringFunc="@(i => i?.FullName)"
                                     SearchFunc="SearchInstructors"
                                     ValueChanged="AddInstructor"
                                     ResetValueOnEmptyText="true" />

                </MudItem>

                <MudItem xs="12">

                    <MudStack Row="true" Spacing="1">
                        @foreach (var instructorId in selectedInstructorIds)
                        {
                            var instructor = instructors.FirstOrDefault(i => i.Id == instructorId);

                            <MudChip T="Guid"
                                     Value="@instructorId"
                                     Text="@instructor?.FullName"
                                     OnClose="RemoveInstructor"
                                     Closeable="true"
                                     Color="Color.Primary"
                                     Variant="Variant.Filled" />
                        }
                    </MudStack>

                </MudItem>

                <MudItem xs="12" md="4">

                    <MudSelect T="Guid ?"
                               Label="Primary Instructor"
                               @bind-Value="primaryInstructorId"
                               Disabled="@(selectedInstructorIds.Count < 2)"
                               ToStringFunc="PrimaryInstructorText">

                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">
                            None
                        </MudSelectItem>

                        @foreach (var instructor in instructors.Where(i => selectedInstructorIds.Contains(i.Id)))
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)instructor.Id)">
                                @instructor.FullName
                            </MudSelectItem>
                        }

                    </MudSelect>

                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField T="int"
                                  Label="Max Capacity"
                                  @bind-Value="model.MaxCapacity"
                                  Required="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField Label="Location" @bind-Value="model.Location" />
                </MudItem>

                <MudItem xs="12" md="3">
                    <MudDatePicker Label="Start Date" @bind-Date="startDate" />
                </MudItem>

                <MudItem xs="12" md="3">
                    <MudTimePicker Label="Start Time" @bind-Time="startTime" />
                </MudItem>

                <MudItem xs="12" md="3">
                    <MudDatePicker Label="End Date" @bind-Date="endDate" />
                </MudItem>

                <MudItem xs="12" md="3">
                    <MudTimePicker Label="End Time" @bind-Time="endTime" />
                </MudItem>

            </MudGrid>

            <MudDivider Class="my-4" />

            <MudStack Row="true" Spacing="2">

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="isSaving"
                           OnClick="Save">

                    Save

                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           OnClick="@(()=>Navigation.NavigateTo("/classes"))">

                    Cancel

                </MudButton>

            </MudStack>

        </MudForm>

    </MudPaper>
}

@code {

    [Parameter]
    public Guid Id { get; set; }

    private MudForm? form;

    private bool isLoading = true;
    private bool isSaving = false;

    private UpdateWorkoutClassDto model = new();

    private DateTime? startDate;
    private TimeSpan? startTime;

    private DateTime? endDate;
    private TimeSpan? endTime;

    private MudAutocomplete<InstructorSummaryDto>? instructorAuto;

    private List<InstructorSummaryDto> instructors = new();

    private List<Guid> selectedInstructorIds = new();

    private Guid? primaryInstructorId;

    protected override async Task OnInitializedAsync()
    {
        await LoadInstructors();
        await LoadClass();
    }

    private async Task LoadInstructors()
    {
        var result = await Http.GetFromJsonAsync<List<InstructorSummaryDto>>("/api/Users/instructors");

        if (result != null)
            instructors = result;
    }

    private async Task LoadClass()
    {
        try
        {
            var dto = await Http.GetFromJsonAsync<WorkoutClassDto>($"api/classes/{Id}");

            if (dto != null)
            {
                model.Title = dto.Title;
                model.Description = dto.Description;
                model.ClassType = dto.ClassType;
                model.MaxCapacity = dto.MaxCapacity;
                model.Location = dto.Location;
                model.IsActive = dto.IsActive;

                selectedInstructorIds = dto.Instructors.Select(i => i.Id).ToList();

                primaryInstructorId = selectedInstructorIds.FirstOrDefault();

                startDate = dto.StartDateTime.Date;
                startTime = dto.StartDateTime.TimeOfDay;

                endDate = dto.EndDateTime.Date;
                endTime = dto.EndDateTime.TimeOfDay;
            }
        }
        catch
        {
            Snackbar.Add("Failed to load class", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task<IEnumerable<InstructorSummaryDto>> SearchInstructors(string value, CancellationToken token)
    {
        var available = instructors
        .Where(i => !selectedInstructorIds.Contains(i.Id));

        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(available);

        var result = available
        .Where(i => i.FullName.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }

    private async Task AddInstructor(InstructorSummaryDto instructor)
    {
        if (instructor == null)
            return;

        if (!selectedInstructorIds.Contains(instructor.Id))
            selectedInstructorIds.Add(instructor.Id);

        UpdatePrimaryInstructor();
        instructorAuto?.ResetAsync();
    }

    private void RemoveInstructor(MudChip<Guid> chip)
    {
        selectedInstructorIds.Remove(chip.Value);

        UpdatePrimaryInstructor();
    }

    private void UpdatePrimaryInstructor()
    {
        if (selectedInstructorIds.Count == 0)
        {
            primaryInstructorId = null;
        }
        else if (selectedInstructorIds.Count == 1)
        {
            primaryInstructorId = selectedInstructorIds.First();
        }
        else
        {
            if (!primaryInstructorId.HasValue || !selectedInstructorIds.Contains(primaryInstructorId.Value))
                primaryInstructorId = null;
        }
    }

    private string PrimaryInstructorText(Guid? id)
    {
        if (!id.HasValue)
            return "None";

        var instructor = instructors.FirstOrDefault(i => i.Id == id.Value);

        return instructor?.FullName ?? "";
    }

    private async Task Save()
    {
        await form.ValidateAsync();

        if (!form.IsValid)
            return;

        isSaving = true;

        try
        {
            if (startDate.HasValue && startTime.HasValue)
                model.StartDateTime = startDate.Value.Add(startTime.Value);

            if (endDate.HasValue && endTime.HasValue)
                model.EndDateTime = endDate.Value.Add(endTime.Value);

            model.InstructorIds = selectedInstructorIds;
            model.PrimaryInstructorId = primaryInstructorId;

            var response = await Http.PutAsJsonAsync($"api/classes/{Id}", model);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Class updated successfully", Severity.Success);
                Navigation.NavigateTo("/classes");
            }
            else
            {
                Snackbar.Add("Failed to update class", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Unexpected error while saving", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

}