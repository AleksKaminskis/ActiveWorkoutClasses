@page "/"
@attribute [Authorize]

@inject IAuthStateService AuthState
@inject NavigationManager Nav

<PageTitle>Dashboard — Active Workout Classes</PageTitle>

<AuthorizeView Roles="Admin">
    <Authorized>
        <AdminDashboard />
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="Instructor">
    <Authorized>
        <InstructorDashboard />
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="Student">
    <Authorized>
        <StudentDashboard />
    </Authorized>
</AuthorizeView>
