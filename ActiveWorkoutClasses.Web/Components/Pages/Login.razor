@page "/login"
@attribute [AllowAnonymous]

@inject IAuthStateService AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Sign In — Active Workout Classes</PageTitle>

<MudGrid Justify="Justify.Center" Style="min-height:80vh;align-items:center;">
    <MudItem xs="12" sm="8" md="5" lg="4">

        <MudPaper Class="pa-8" Elevation="6">

            <MudStack AlignItems="AlignItems.Center" Class="mb-6">
                <MudText Typo="Typo.h4"
                         Style="font-family:'Barlow Condensed',sans-serif;font-weight:700;letter-spacing:1px;color:#FF6B35;">
                    ACTIVE WORKOUT
                </MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                    Sign in to your account
                </MudText>
            </MudStack>

            <MudForm @ref="_form">
                <MudTextField @bind-Value="_email"
                              Label="Email"
                              InputType="InputType.Email"
                              Required="true"
                              RequiredError="Email is required"
                              Variant="Variant.Outlined"
                              Class="mb-3" />

                <MudTextField @bind-Value="_password"
                              Label="Password"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Required="true"
                              RequiredError="Password is required"
                              Variant="Variant.Outlined"
                              Class="mb-4"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showPassword = !_showPassword)" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="_isLoading"
                           OnClick="@HandleLogin">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Sign In
                </MudButton>
            </MudForm>

            <MudDivider Class="my-4" />

            <MudStack AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Don't have an account?
                    <MudLink Href="/register" Color="Color.Primary">Register</MudLink>
                </MudText>
            </MudStack>

        </MudPaper>

    </MudItem>
</MudGrid>

@code {

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private MudForm? _form;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _showPassword;
    private bool _isLoading;

    protected override void OnInitialized()
    {
        if (AuthState.IsAuthenticated)
            Nav.NavigateTo(ReturnUrl ?? "/");
    }

    private async Task HandleLogin()
    {
        if (_form is null) return;
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _isLoading = true;
        try
        {
            var success = await AuthState.LoginAsync(_email, _password);
            if (success)
                Nav.NavigateTo(ReturnUrl ?? "/");
            else
                Snackbar.Add("Invalid email or password", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Login error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

}
