@using ActiveWorkoutClasses.Application.DTOs.Classes

@inject IApiClient Api
@inject IAuthStateService AuthState

<MudText Typo="Typo.h4" Class="mb-6"
         Style="font-family:'Barlow Condensed',sans-serif;font-weight:700;">
    Instructor Dashboard — @AuthState.FullName
</MudText>

<MudGrid>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="3">
            <MudText Typo="Typo.h6" Class="mb-3">Quick Actions</MudText>
            <MudStack Spacing="2">
                <MudButton Href="/classes" StartIcon="@Icons.Material.Filled.FitnessCenter"
                           Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true">
                    Manage Classes
                </MudButton>
                <MudButton Href="/grading-events" StartIcon="@Icons.Material.Filled.Grade"
                           Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true">
                    Grading Events
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="3">
            <MudText Typo="Typo.h6" Class="mb-3">Upcoming Classes</MudText>
            @if (_isLoading)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (_classes.Count == 0)
            {
                <MudText Color="Color.Secondary">No upcoming classes found.</MudText>
            }
            else
            {
                @foreach (var cls in _classes.Take(5))
                {
                    <MudPaper Class="pa-2 mb-2" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">@cls.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @cls.StartDateTime.ToString("ddd dd MMM HH:mm")
                            </MudText>
                        </MudStack>
                    </MudPaper>
                }
            }
        </MudPaper>
    </MudItem>

</MudGrid>

@code {

    private bool _isLoading = true;
    private List<WorkoutClassDto> _classes = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var paged = await Api.GetAsync<WorkoutClassListDto>("api/classes");
            if (paged?.Classes is not null)
                _classes = paged.Classes.Where(c => c.StartDateTime >= DateTime.UtcNow).OrderBy(c => c.StartDateTime).ToList();
        }
        catch { }
        finally { _isLoading = false; }
    }

}
